# ============================================================
#  docker-compose 用的变量模板
# ------------------------------------------------------------
#  用法：
#    cp .env.example .env      然后用 DataGrip / 记事本把值填上
#
#  ⚠️ 真正的 .env 已经被 .gitignore 挡住，不会被提交到 GitHub。
#     千万别把带真实密钥的版本换个名字提交上去。
#
#  生成随机串（随便挑一种）：
#    Python： python -c "import secrets; print(secrets.token_urlsafe(48))"
#    在线：   https://www.random.org/strings/
# ============================================================

# ---------- 数据库 ----------
# 容器里 MySQL 的 root 密码（和本机那个不是一回事）
MYSQL_ROOT_PASSWORD=换成你自己的强密码
MYSQL_DATABASE=commerce_service

# ---------- JWT 签名密钥 ----------
# 换了它，所有人之前的登录状态都会失效，这是正常的
JWT_SECRET=换成一段长随机串

# ---------- 内部接口令牌 ----------
# Java 的 internal.token 和 Python 的 INTERNAL_TOKEN 都读这个值，
# 所以它天然两边一致 —— 这正是当初用同一个变量的原因
INTERNAL_TOKEN=换成另一个随机串

# ---------- DeepSeek ----------
DEEPSEEK_API_KEY=sk-你的key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
