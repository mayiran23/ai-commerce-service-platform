# ============================================================
# 配置模板
#
# 用法：
#   cp src/main/resources/application.properties.example src/main/resources/application.properties
# 然后把下面标了「改成你自己的」几项填上。
#
# 真实的 application.properties 已在 .gitignore 里，不会被提交（里面是你的数据库密码）。
# ============================================================

spring.application.name=commerce-service

# ---------- 数据库 ----------
# 库名默认 commerce_service，由 sql/schema.sql 自动创建，一般不用改
spring.datasource.url=jdbc:mysql://localhost:3306/commerce_service?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
spring.datasource.username=root
spring.datasource.password=改成你自己的数据库密码

# ---------- MyBatis ----------
mybatis.configuration.map-underscore-to-camel-case=true
mybatis.mapper-locations=classpath*:/mapper/**/*.xml

# ---------- JWT ----------
# secret 换成一串随机字符串（越长越好），不要照抄下面这个示例值
jwt.secret=改成一段随机字符串
jwt.expire-hours=24

# ---------- 内部接口（Python AI 服务 → Java）----------
# ⚠️ 必须和 ai-service/.env 里的 INTERNAL_TOKEN 完全一致，否则 AI 调不通内部接口
internal.token=改成你自己的密钥并保证两边一致

# ---------- AI 服务地址 ----------
ai.service.url=http://localhost:8000

# ---------- 服务端口（默认 8080，需要时取消注释） ----------
# server.port=8080
