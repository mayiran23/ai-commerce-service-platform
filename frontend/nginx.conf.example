# 智联商城 · 智能客服平台 —— nginx 配置示例
#
# 这就是苍穹外卖那套做法：nginx 同时干两件事
#   1. 把 frontend/ 里的静态文件发给浏览器
#   2. 把 /api 开头的请求转发给 Spring Boot（8080）
#
# 这样前端用相对路径 /api/orders 发请求，前后端同源，不需要配 CORS。
#
# ============================================================
# 【Windows 本地】已经装好并跑起来了，可直接用
#   nginx 目录：D:\mayiran-work\tools\nginx-1.30.4
#   实际配置：  D:\mayiran-work\tools\nginx-1.30.4\conf\nginx.conf
#   访问地址：  http://localhost:8081
#   启停脚本：  nginx 目录下的 nginx-start.bat / nginx-stop.bat / nginx-reload.bat
#   为什么不是 80：本机 80 端口被别的程序占用了，换 8081 避开
#   （下面的示例是 Linux 服务器用的，listen 写 80；本地那份是 8081）
#
# 【Ubuntu 服务器】怎么用：
#   1. 把 frontend/ 目录上传到 /var/www/commerce-service
#   2. sudo cp nginx.conf.example /etc/nginx/sites-available/commerce-service
#   3. sudo ln -s /etc/nginx/sites-available/commerce-service /etc/nginx/sites-enabled/
#   4. sudo nginx -t && sudo systemctl reload nginx
# ============================================================

server {
    listen       80;
    server_name  localhost;

    # 前端静态文件目录
    # Windows 下改成本地路径，注意必须用正斜杠：
    #   root  D:/mayiran-work/projects/ai-commerce-service-platform/frontend;
    root  /var/www/commerce-service;
    index  login.html;

    charset utf-8;
    client_max_body_size 20m;

    # 出问题先看这两个日志
    access_log  /var/log/nginx/commerce-access.log;
    error_log   /var/log/nginx/commerce-error.log;

    # ---------- 1. 前端页面 ----------
    location / {
        try_files $uri $uri/ =404;
    }

    # ---------- 2. 静态资源 ----------
    # 故意不开 expires 缓存。开发阶段一开缓存，你改完 css/js 刷新看不到效果，
    # 会以为代码写错了。真正上线时再改成 expires 1h。
    location ~* \.(css|js|png|jpg|jpeg|gif|svg|ico|woff2?)$ {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        expires -1;
    }

    # ---------- 3. 接口反代到 Spring Boot ----------
    location /api/ {
        proxy_pass http://127.0.0.1:8080;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 对话接口要等大模型，超时别设太短，否则会 504
        proxy_connect_timeout 10s;
        proxy_send_timeout    60s;
        proxy_read_timeout    60s;
    }

    # ---------- 4. 内部接口绝对不对外暴露 ----------
    # /internal/* 是给 Python AI 服务在本机内部调用的，
    # 从公网必须访问不到。前端也不调它。
    location /internal/ {
        deny all;
        return 403;
    }

    # ---------- 5. gzip ----------
    gzip on;
    gzip_min_length 1k;
    gzip_comp_level 4;
    gzip_types text/plain text/css application/javascript application/json;
}
